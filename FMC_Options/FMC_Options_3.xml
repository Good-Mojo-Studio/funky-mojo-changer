<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
	<Frame parentKey="Panel3" inherits="vdwOptionsPanel" parent="fmcOptions">
		<Size x="568" y="452"/>
		<Frames>
<!-- Options Box 1 visibility direction talent buttons -->
			<Frame parentKey="Box1" inherits="vdwOptionsBox">
				<Anchors>
					<Anchor point="TOPLEFT" relativePoint="TOPLEFT" x ="8" y="-64"/>
				</Anchors>
				<Frames>
<!-- Pop Out 1 visibility -->
					<Button parentKey="PopOut1" inherits="vdwPopOut">
						<Anchors>
							<Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="4" y="-40"/>
						</Anchors>
					</Button>
<!-- Pop Out 2 direction -->
					<Button parentKey="PopOut2" inherits="vdwPopOut">
						<Anchors>
							<Anchor point="LEFT" relativeKey="$parent.PopOut1" relativePoint="RIGHT" x="8" y="0"/>
						</Anchors>
					</Button>
				</Frames>
			</Frame>
<!-- Options Box 2 visibility style animation -->
			<Frame parentKey="Box2" inherits="vdwOptionsBox">
				<Frames>
<!-- Pop Out 1 visibility -->
					<Button parentKey="PopOut1" inherits="vdwPopOut">
						<Anchors>
							<Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="4" y="-40"/>
						</Anchors>
					</Button>
<!-- Pop Out 2 style -->
					<Button parentKey="PopOut2" inherits="vdwPopOut">
						<Anchors>
							<Anchor point="LEFT" relativeKey="$parent.PopOut1" relativePoint="RIGHT" x="8" y="0"/>
						</Anchors>
					</Button>
				</Frames>
			</Frame>
<!-- Options Box 3 lock style banner -->
			<Frame parentKey="Box3" inherits="vdwOptionsBox">
				<Frames>
<!-- Pop Out 2 style -->
					<Button parentKey="PopOut2" inherits="vdwPopOut">
						<Anchors>
							<Anchor point="TOP" relativePoint="TOP" x="0" y="-40"/>
						</Anchors>
					</Button>
<!--Slider 1, width -->	
					<Frame parentKey="Slider1" inherits="vdwSlider">
						<Anchors>
							<Anchor point="TOP" relativeKey="$parent.Title" relativePoint="BOTTOM" x="0" y="-56"/>
						</Anchors>
					</Frame>
<!--Slider 2, height -->	
					<Frame parentKey="Slider2" inherits="vdwSlider">
						<Anchors>
							<Anchor point="TOP" relativeKey="$parent.Slider1" relativePoint="BOTTOM" x="0" y="-8"/>
						</Anchors>
					</Frame>
				</Frames>
			</Frame>
<!-- Options Box 4 Note box -->
			<Frame parentKey="Box4" inherits="vdwOptionsBox">
				<Layers>
					<Layer level="OVERLAY">
						<FontString parentKey="Notes" font="vdw_NFshadow_13" justifyV="MIDDLE" justifyH="CENTER">
							<Anchors>
								<Anchor point="TOP" relativePoint="TOP" x="0" y="-32"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Frame>
<!-- Options Box 5 Note box -->
			<Frame parentKey="Box5" inherits="vdwOptionsBox">
				<Layers>
					<Layer level="OVERLAY">
						<FontString parentKey="Notes" font="vdw_NFshadow_13" justifyV="MIDDLE" justifyH="CENTER">
							<Anchors>
								<Anchor point="TOP" relativePoint="TOP" x="0" y="-32"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Frame>
		</Frames>
	</Frame>
	<Script file="FMC_Options_3.lua"/>
